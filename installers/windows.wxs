<?xml version="1.0" encoding="UTF-8"?>
<!--
  Notepatra Windows MSI installer — WiX Toolset v3.
  Enterprise-grade Windows installer. Produces notepatra-<VERSION>.msi
  which installs per-machine (Program Files + HKLM registry) or per-user
  based on MSIINSTALLPERUSER property.

  Build command (CI):
    candle -arch x64 -dVersion=%VERSION% -dSourceDir=notepatra-win installers\windows.wxs
    light -ext WixUIExtension -ext WixUtilExtension -cultures:en-us -out notepatra-%VERSION%.msi windows.wixobj

  Output: notepatra-<VERSION>.msi (signed via signtool in CI post-build)
-->

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?define ProductName = "Notepatra" ?>
  <?define Publisher = "Prateek Singh" ?>
  <?define UpgradeCode = "8D5E3C42-1F9A-4B7E-9D6C-1A2B3C4D5E6F" ?>
  <?define HelpUrl = "https://github.com/singhpratech/notepatra" ?>
  <?define HomeUrl = "https://notepatra.org" ?>

  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="$(var.Publisher)"
           UpgradeCode="$(var.UpgradeCode)">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="Notepatra Native code editor for the AI era"
             Comments="Native C++/Rust code editor for the AI era. Local AI formatters (Ollama/llama.cpp). GPL-3.0 licensed."
             Manufacturer="$(var.Publisher)" />

    <!-- Auto-upgrade: uninstall older versions when installing newer ones -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Notepatra is already installed."
                  Schedule="afterInstallInitialize" />

    <!-- Embed all files in the MSI rather than an external .cab -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Icon shown in Add/Remove Programs -->
    <Icon Id="NotepatraIcon.exe" SourceFile="$(var.SourceDir)\notepatra.exe" />
    <Property Id="ARPPRODUCTICON" Value="NotepatraIcon.exe" />
    <Property Id="ARPHELPLINK" Value="$(var.HelpUrl)" />
    <Property Id="ARPURLINFOABOUT" Value="$(var.HomeUrl)" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/singhpratech/notepatra/releases/latest" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- Launch after install checkbox -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Notepatra" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#NotepatraExe]" />
    <CustomAction Id="LaunchApplication"
                  BinaryKey="WixCA"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <!-- Request admin on install (per-machine). NOTE: ALLUSERS /
         MSIINSTALLPERUSER are NOT declared here — the InstallScope
         attribute on <Package> above already sets them, and
         re-declaring them collides with the same properties that
         WixUI_FeatureTree defines internally (LGHT0091). -->

    <!-- Install locations -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)">
          <!-- All app files go here. The actual file list is generated
               by heat.exe at build time into a separate include file. -->
          <Component Id="MainExecutable" Guid="A2F3B641-8E7D-4C5A-B1D2-3E4F5A6B7C8D" Win64="yes">
            <File Id="NotepatraExe"
                  Source="$(var.SourceDir)\notepatra.exe"
                  KeyPath="yes" />

            <!-- File-type associations. One ProgId for everything; a
                 single shared <Verb> under the first Extension, with
                 Id="NotepatraOpen" so its registry hash is unique. The
                 rest of the extensions inherit the ProgId by Advertise
                 so they all open with Notepatra without re-declaring
                 Verbs (which caused LGHT0130 Registry-key collisions). -->
            <ProgId Id="Notepatra.Document" Description="Notepatra Document">
              <Extension Id="txt" ContentType="text/plain">
                <Verb Id="NotepatraOpen" Command="Open with Notepatra"
                      TargetFile="NotepatraExe" Argument='"%1"' />
              </Extension>
              <Extension Id="log"  />
              <Extension Id="md"   />
              <Extension Id="json" />
              <Extension Id="xml"  />
              <Extension Id="yaml" />
              <Extension Id="yml"  />
              <Extension Id="ini"  />
              <Extension Id="conf" />
              <Extension Id="cfg"  />
              <Extension Id="csv"  />
              <Extension Id="py"   />
              <Extension Id="js"   />
              <Extension Id="ts"   />
              <Extension Id="cpp"  />
              <Extension Id="c"    />
              <Extension Id="h"    />
              <Extension Id="hpp"  />
              <Extension Id="rs"   />
              <Extension Id="go"   />
              <Extension Id="java" />
              <Extension Id="cs"   />
              <Extension Id="sql"  />
              <Extension Id="html" />
              <Extension Id="css"  />
              <Extension Id="sh"   />
              <Extension Id="ps1"  />
            </ProgId>

            <!-- ─── Right-click shell integration (Notepad++ / VS Code style) ───
                 "Edit with Notepatra" on ANY file (HKCR\*), plus "Open folder
                 in Notepatra" when right-clicking a folder or the empty
                 space inside one. Icons come from the main .exe. These
                 cover the cases our ProgId-only associations miss:
                 ─ unknown extensions not listed in the ProgId block above
                 ─ folders (the ProgId block only binds to file types)
                 ─ background right-click inside a folder ("Open here in Notepatra") -->
            <RegistryValue Root="HKCR" Key="*\shell\Edit with Notepatra"
                           Value="Edit with Notepatra" Type="string" />
            <RegistryValue Root="HKCR" Key="*\shell\Edit with Notepatra"
                           Name="Icon" Value='"[#NotepatraExe]"' Type="string" />
            <RegistryValue Root="HKCR" Key="*\shell\Edit with Notepatra\command"
                           Value='"[#NotepatraExe]" "%1"' Type="string" />

            <RegistryValue Root="HKCR" Key="Directory\shell\Open in Notepatra"
                           Value="Open folder in Notepatra" Type="string" />
            <RegistryValue Root="HKCR" Key="Directory\shell\Open in Notepatra"
                           Name="Icon" Value='"[#NotepatraExe]"' Type="string" />
            <RegistryValue Root="HKCR" Key="Directory\shell\Open in Notepatra\command"
                           Value='"[#NotepatraExe]" "%1"' Type="string" />

            <RegistryValue Root="HKCR" Key="Directory\Background\shell\Open in Notepatra"
                           Value="Open folder in Notepatra" Type="string" />
            <RegistryValue Root="HKCR" Key="Directory\Background\shell\Open in Notepatra"
                           Name="Icon" Value='"[#NotepatraExe]"' Type="string" />
            <RegistryValue Root="HKCR" Key="Directory\Background\shell\Open in Notepatra\command"
                           Value='"[#NotepatraExe]" "%V"' Type="string" />

            <!-- Add Notepatra to the Windows PATH (system-wide) -->
            <Environment Id="NotepatraPath"
                         Name="PATH"
                         Value="[INSTALLFOLDER]"
                         Permanent="no"
                         Part="last"
                         Action="set"
                         System="yes" />
          </Component>

          <!-- All other files (Qt DLLs, platforms, etc) harvested by heat.exe
               into a generated HarvestedFiles.wxs during CI build. That file
               defines the component group "HarvestedComponents" referenced
               in the Feature below. -->
        </Directory>
      </Directory>

      <!-- Start Menu shortcut -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="$(var.ProductName)" />
      </Directory>

      <!-- Desktop shortcut -->
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <!-- Start Menu shortcut component -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="C3D4E5F6-7A8B-9C0D-1E2F-3A4B5C6D7E8F">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="$(var.ProductName)"
                  Description="Native C++/Rust code editor with AI formatters"
                  Target="[INSTALLFOLDER]notepatra.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  />
        <RemoveFolder Id="CleanUpShortcut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\$(var.Publisher)\$(var.ProductName)"
                       Name="startmenu"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Desktop shortcut component (optional feature) -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="D4E5F6A7-8B9C-0D1E-2F3A-4B5C6D7E8F9A">
        <Shortcut Id="DesktopShortcut"
                  Name="$(var.ProductName)"
                  Description="Native C++/Rust code editor with AI formatters"
                  Target="[INSTALLFOLDER]notepatra.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  />
        <RegistryValue Root="HKCU"
                       Key="Software\$(var.Publisher)\$(var.ProductName)"
                       Name="desktop"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Features: main (required) + desktop shortcut (optional) -->
    <Feature Id="ProductFeature" Title="Notepatra" Level="1"
             Description="Notepatra editor core (required)." Absent="disallow">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
      <!-- ComponentGroupRef Id="HarvestedComponents" / — injected at build time -->
    </Feature>

    <Feature Id="DesktopShortcutFeature" Title="Desktop Shortcut" Level="1"
             Description="Create a Notepatra shortcut on the Desktop.">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Use the standard WiX UI with license page -->
    <UIRef Id="WixUI_FeatureTree" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <WixVariable Id="WixUILicenseRtf" Value="installers\license.rtf" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApplication" After="InstallFinalize">
        NOT Installed AND WIXUI_EXITDIALOGOPTIONALCHECKBOX=1
      </Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
