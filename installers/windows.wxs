<?xml version="1.0" encoding="UTF-8"?>
<!--
  Notepatra Windows MSI installer — WiX Toolset v3.
  Enterprise-grade Windows installer. Produces notepatra-<VERSION>.msi
  which installs per-machine (Program Files + HKLM registry) or per-user
  based on MSIINSTALLPERUSER property.

  Build command (CI):
    candle -arch x64 -dVersion=%VERSION% -dSourceDir=notepatra-win installers\windows.wxs
    light -ext WixUIExtension -ext WixUtilExtension -cultures:en-us -out notepatra-%VERSION%.msi windows.wixobj

  Output: notepatra-<VERSION>.msi (signed via signtool in CI post-build)
-->

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <!-- v0.1.72 — Two MSI flavors share this wxs file.  Pass `-dNoCloud`
       to candle.exe to compile the cloud-free variant (notepatra-local-ai).
       Both flavors install per-machine, but they have:
         • different ProductName    (different entry in Add/Remove Programs)
         • different UpgradeCode    (independent upgrade paths — MSI sees
                                     them as two distinct products)
         • different INSTALLFOLDER  (different install dir on disk)
         • different Description / Comments in the package metadata
       so an admin can deploy either or both side-by-side.  Pick the
       local-ai MSI for regulated environments where public LLM
       endpoints must be blocked at the binary level. -->
  <?ifdef NoCloud ?>
    <?define ProductName = "Notepatra Local AI" ?>
    <?define UpgradeCode = "B7C8D9E0-1F2A-3B4C-5D6E-7F8A9B0C1D2E" ?>
    <?define ProductDescription = "Notepatra Local AI" ?>
    <?define ProductComments = "Cloud-free Notepatra — local and private-network LLM endpoints only. The binary physically refuses to talk to api.openai.com / api.anthropic.com / api.mistral.ai / openrouter.ai / generativelanguage.googleapis.com / any public LLM endpoint. Ollama, llama.cpp, LM Studio, Jan, self-hosted Ollama on the LAN continue to work. GPL-3.0 licensed." ?>
    <?define LaunchText = "Launch Notepatra Local AI" ?>
    <!-- v0.1.77 — per-variant ProgId + shell-verb names so the two MSIs
         write to NON-OVERLAPPING HKCR registry trees. Before this, both
         flavors wrote HKCR\Notepatra.Document and HKCR\*\shell\Edit with
         Notepatra, which Windows refused to refcount across products
         and surfaced as the Repair/Remove maintenance UI. -->
    <?define ProgIdName     = "Notepatra.LocalAI.Document" ?>
    <?define ProgIdDescr    = "Notepatra Local AI Document" ?>
    <?define ShellOpenVerb  = "NotepatraLocalAIOpen" ?>
    <?define ShellOpenTitle = "Open with Notepatra Local AI" ?>
    <?define ShellEditKey   = "Edit with Notepatra Local AI" ?>
    <?define ShellDirKey    = "Open in Notepatra Local AI" ?>
    <?define ShellDirTitle  = "Open folder in Notepatra Local AI" ?>
  <?else ?>
    <?define ProductName = "Notepatra" ?>
    <?define UpgradeCode = "8D5E3C42-1F9A-4B7E-9D6C-1A2B3C4D5E6F" ?>
    <?define ProductDescription = "Notepatra" ?>
    <?define ProductComments = "Native C++/Rust code editor for the AI era. Local AI formatters (Ollama/llama.cpp). GPL-3.0 licensed." ?>
    <?define LaunchText = "Launch Notepatra" ?>
    <?define ProgIdName     = "Notepatra.Document" ?>
    <?define ProgIdDescr    = "Notepatra Document" ?>
    <?define ShellOpenVerb  = "NotepatraOpen" ?>
    <?define ShellOpenTitle = "Open with Notepatra" ?>
    <?define ShellEditKey   = "Edit with Notepatra" ?>
    <?define ShellDirKey    = "Open in Notepatra" ?>
    <?define ShellDirTitle  = "Open folder in Notepatra" ?>
  <?endif ?>
  <?define Publisher = "Prateek Singh" ?>
  <?define HelpUrl = "https://github.com/singhpratech/notepatra" ?>
  <?define HomeUrl = "https://notepatra.org" ?>

  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="$(var.Publisher)"
           UpgradeCode="$(var.UpgradeCode)">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="$(var.ProductDescription)"
             Comments="$(var.ProductComments)"
             Manufacturer="$(var.Publisher)" />

    <!-- Auto-upgrade: uninstall older versions when installing newer ones.
         v0.1.74 — added AllowSameVersionUpgrades=yes so reinstalling the
         same version doesn't drop the user into the maintenance UI; it
         re-runs the install cleanly. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed."
                  AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize" />

    <!-- Embed all files in the MSI rather than an external .cab -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Icon shown in Add/Remove Programs -->
    <Icon Id="NotepatraIcon.exe" SourceFile="$(var.SourceDir)\notepatra.exe" />
    <Property Id="ARPPRODUCTICON" Value="NotepatraIcon.exe" />
    <Property Id="ARPHELPLINK" Value="$(var.HelpUrl)" />
    <Property Id="ARPURLINFOABOUT" Value="$(var.HomeUrl)" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/singhpratech/notepatra/releases/latest" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- Launch after install checkbox -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="$(var.LaunchText)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#NotepatraExe]" />
    <CustomAction Id="LaunchApplication"
                  BinaryKey="WixCA"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <!-- Request admin on install (per-machine). NOTE: ALLUSERS /
         MSIINSTALLPERUSER are NOT declared here — the InstallScope
         attribute on <Package> above already sets them, and
         re-declaring them collides with the same properties that
         WixUI_FeatureTree defines internally (LGHT0091). -->

    <!-- Install locations -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)">
          <!-- All app files go here. The actual file list is generated
               by heat.exe at build time into a separate include file. -->
          <!-- v0.1.74 — `Guid="*"` makes WiX auto-generate the component
               GUID deterministically from the component's KeyPath. Because
               INSTALLFOLDER differs by flavor ("Notepatra" vs "Notepatra
               Local AI"), regular and local-ai end up with DIFFERENT
               component GUIDs and Windows stops reference-counting them
               as the same component. This is the fix for the v0.1.72/v0.1.73
               local-ai upgrade dropping into Repair/Remove instead of
               doing a major upgrade — when a user had BOTH flavors
               installed, the shared hardcoded GUID caused refcount
               conflicts that broke the local-ai upgrade flow. -->
          <Component Id="MainExecutable" Guid="*" Win64="yes">
            <File Id="NotepatraExe"
                  Source="$(var.SourceDir)\notepatra.exe"
                  KeyPath="yes" />

            <!-- File-type associations. One ProgId for everything; a
                 single shared <Verb> under the first Extension. The
                 rest of the extensions inherit the ProgId by Advertise
                 so they all open with the right binary without
                 re-declaring Verbs (which caused LGHT0130 Registry-key
                 collisions).

                 v0.1.77 — ProgId Id and Verb Id are variant-scoped
                 (`Notepatra.Document` vs `Notepatra.LocalAI.Document`,
                 `NotepatraOpen` vs `NotepatraLocalAIOpen`) so installing
                 both flavors side-by-side no longer collides on
                 HKCR\Notepatra.Document — each flavor owns its own
                 ProgId tree and Windows doesn't surface the Repair/Remove
                 maintenance UI. -->
            <ProgId Id="$(var.ProgIdName)" Description="$(var.ProgIdDescr)">
              <Extension Id="txt" ContentType="text/plain">
                <Verb Id="$(var.ShellOpenVerb)" Command="$(var.ShellOpenTitle)"
                      TargetFile="NotepatraExe" Argument='"%1"' />
              </Extension>
              <Extension Id="log"  />
              <Extension Id="md"   />
              <Extension Id="json" />
              <Extension Id="xml"  />
              <Extension Id="yaml" />
              <Extension Id="yml"  />
              <Extension Id="ini"  />
              <Extension Id="conf" />
              <Extension Id="cfg"  />
              <Extension Id="csv"  />
              <Extension Id="py"   />
              <Extension Id="js"   />
              <Extension Id="ts"   />
              <Extension Id="cpp"  />
              <Extension Id="c"    />
              <Extension Id="h"    />
              <Extension Id="hpp"  />
              <Extension Id="rs"   />
              <Extension Id="go"   />
              <Extension Id="java" />
              <Extension Id="cs"   />
              <Extension Id="sql"  />
              <Extension Id="html" />
              <Extension Id="css"  />
              <Extension Id="sh"   />
              <Extension Id="ps1"  />
            </ProgId>

            <!-- ─── Right-click shell integration (Notepad++ / VS Code style) ───
                 "Edit with Notepatra" on ANY file (HKCR\*), plus "Open folder
                 in Notepatra" when right-clicking a folder or the empty
                 space inside one. Icons come from the main .exe. These
                 cover the cases our ProgId-only associations miss:
                 ─ unknown extensions not listed in the ProgId block above
                 ─ folders (the ProgId block only binds to file types)
                 ─ background right-click inside a folder ("Open here in Notepatra") -->
            <RegistryValue Root="HKCR" Key="*\shell\$(var.ShellEditKey)"
                           Value="$(var.ShellEditKey)" Type="string" />
            <RegistryValue Root="HKCR" Key="*\shell\$(var.ShellEditKey)"
                           Name="Icon" Value='"[#NotepatraExe]"' Type="string" />
            <RegistryValue Root="HKCR" Key="*\shell\$(var.ShellEditKey)\command"
                           Value='"[#NotepatraExe]" "%1"' Type="string" />

            <RegistryValue Root="HKCR" Key="Directory\shell\$(var.ShellDirKey)"
                           Value="$(var.ShellDirTitle)" Type="string" />
            <RegistryValue Root="HKCR" Key="Directory\shell\$(var.ShellDirKey)"
                           Name="Icon" Value='"[#NotepatraExe]"' Type="string" />
            <RegistryValue Root="HKCR" Key="Directory\shell\$(var.ShellDirKey)\command"
                           Value='"[#NotepatraExe]" "%1"' Type="string" />

            <RegistryValue Root="HKCR" Key="Directory\Background\shell\$(var.ShellDirKey)"
                           Value="$(var.ShellDirTitle)" Type="string" />
            <RegistryValue Root="HKCR" Key="Directory\Background\shell\$(var.ShellDirKey)"
                           Name="Icon" Value='"[#NotepatraExe]"' Type="string" />
            <RegistryValue Root="HKCR" Key="Directory\Background\shell\$(var.ShellDirKey)\command"
                           Value='"[#NotepatraExe]" "%V"' Type="string" />

            <!-- Add Notepatra to the Windows PATH (system-wide) -->
            <Environment Id="NotepatraPath"
                         Name="PATH"
                         Value="[INSTALLFOLDER]"
                         Permanent="no"
                         Part="last"
                         Action="set"
                         System="yes" />
          </Component>

          <!-- All other files (Qt DLLs, platforms, etc) harvested by heat.exe
               into a generated HarvestedFiles.wxs during CI build. That file
               defines the component group "HarvestedComponents" referenced
               in the Feature below. -->
        </Directory>
      </Directory>

      <!-- Start Menu shortcut -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="$(var.ProductName)" />
      </Directory>

      <!-- Desktop shortcut -->
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <!-- Start Menu shortcut component -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="*">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="$(var.ProductName)"
                  Description="Native C++/Rust code editor with AI formatters"
                  Target="[INSTALLFOLDER]notepatra.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  />
        <RemoveFolder Id="CleanUpShortcut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\$(var.Publisher)\$(var.ProductName)"
                       Name="startmenu"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Desktop shortcut component (optional feature) -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="DesktopShortcut"
                  Name="$(var.ProductName)"
                  Description="Native C++/Rust code editor with AI formatters"
                  Target="[INSTALLFOLDER]notepatra.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  />
        <RegistryValue Root="HKCU"
                       Key="Software\$(var.Publisher)\$(var.ProductName)"
                       Name="desktop"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Features: main (required) + desktop shortcut (optional) -->
    <Feature Id="ProductFeature" Title="Notepatra" Level="1"
             Description="Notepatra editor core (required)." Absent="disallow">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
      <!-- ComponentGroupRef Id="HarvestedComponents" / — injected at build time -->
    </Feature>

    <Feature Id="DesktopShortcutFeature" Title="Desktop Shortcut" Level="1"
             Description="Create a Notepatra shortcut on the Desktop.">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Use the standard WiX UI with license page -->
    <UIRef Id="WixUI_FeatureTree" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <WixVariable Id="WixUILicenseRtf" Value="installers\license.rtf" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApplication" After="InstallFinalize">
        NOT Installed AND WIXUI_EXITDIALOGOPTIONALCHECKBOX=1
      </Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
