build/
# v0.1.64+ uses build-lite/ for the default lite-flavor build and
# build-full/ for the optional WebEngine-bundled flavor, so both are
# ignored alongside the legacy build/ output dir.
build-lite/
build-full/
# v0.1.72+ per-release / per-flavor scratch build dirs created during
# local Docker iteration on installers (build-v172, build-v172-nocloud,
# build-nocloud).  Generic pattern catches future versions too.
build-v*/
# v0.1.114 — ASan and release-test scratch dirs from the open-pipeline
# deep-dive sessions.
build-asan/
build-reltest/
build-nocloud/

# v0.1.72 — Linux installer outputs left behind by local Docker test
# runs (the installer build-* scripts write packages to cwd).  CI
# uploads them to GitHub Releases directly; they should never land in
# the repo.
*.deb
*.rpm
*.AppImage
# Historical per-release worktrees (v0.1.61 / v0.1.62 / v0.1.63 etc).
# Registered via `git worktree add`; the working trees live inside
# this directory but their commit history is on the corresponding
# feature/* branches, so the top-level dir doesn't belong in the
# main branch's index.
.worktrees/
rust-core/target/
*.o
*.so
*.a
.cache/
test_lexers
# Local cross-compile output / release artifacts
artifacts/
# Claude Code session metadata — per-user, not project state
.claude/
# CTest scratch directory
Testing/

# Internal launch / outreach prep notes — Show HN draft, Reddit posts,
# Product Hunt copy, etc. Kept locally, not pushed to public repo so
# the launch copy isn't readable before launch.
outreach/

# Local-only screenshot/screencast capture dirs and loose images at
# repo root. v0.1.31 added these after the tour.gif privacy incident
# (filesystem paths captured in screenshots got pushed to the public
# website). Anything visual that lands in the public repo must go
# through docs/screenshots/ with an explicit PII-scrub review first.
issuesinwindows/
icon-previews/
img*.png
images.zip
images/
*.gif.local

# Vendored libduckdb prebuilt amalgamation (~32 MB) — fetched at configure time
vendor/duckdb/libduckdb.zip
vendor/duckdb/libduckdb.so
vendor/duckdb/libduckdb_static.a

# Vendored binary deps (downloaded by build scripts)
vendor/

# Test harness scratch — generated artefacts from tests/comprehensive/.
# The harness writes JSON results, captures screenshots, and Python
# byte-caches its runners; none of it is checkable-in source.
tests/comprehensive/results/
tests/comprehensive/screenshots/
tests/comprehensive/__pycache__/
tests/comprehensive/run.log

# Local-only test runners that still bake user-specific paths.
# When their hardcoded `/home/...` paths are scrubbed they can be
# checked in alongside the comprehensive harness.
tests/comprehensive/run_ui_smoke.sh
tests/comprehensive/run_duckdb_tests.py

# User-pasted test artifacts. Per memory rule: never commit (PII risk).
test-files/
# Local planning scratch — agent-only, not for the repo.
planning/

# Local scratch build dir for Lite-flavor verification.
build-lite-verify/

# Data-Analyst eval artifacts — large binaries + generated reports stay local.
# (The harness code, grounding, questions, schema + ground_truth ARE committed.)
eval/data-analyst/datasets/synthea.duckdb
eval/data-analyst/datasets/synthea.sqlite
eval/data-analyst/datasets/bin/
eval/data-analyst/.eval_checkpoint.jsonl
eval/data-analyst/report.html
eval/data-analyst/report.json
eval/**/__pycache__/

# Stray local scratch files (pre-existing, 2026-07-09) — an accidental README
# duplicate and an empty saved "new tab". Ignored, not deleted: they are the
# user's local files, and ignoring keeps them out of commits + satisfies the
# release-check "clean tree" gate without touching them.
/README (copy).md
/tests/new 3test.md
