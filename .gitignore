build/
rust-core/target/
*.o
*.so
*.a
.cache/
test_lexers
# Local cross-compile output / release artifacts
artifacts/
# Claude Code session metadata — per-user, not project state
.claude/
# CTest scratch directory
Testing/

# Internal launch / outreach prep notes — Show HN draft, Reddit posts,
# Product Hunt copy, etc. Kept locally, not pushed to public repo so
# the launch copy isn't readable before launch.
outreach/

# Local-only screenshot/screencast capture dirs and loose images at
# repo root. v0.1.31 added these after the tour.gif privacy incident
# (filesystem paths captured in screenshots got pushed to the public
# website). Anything visual that lands in the public repo must go
# through docs/screenshots/ with an explicit PII-scrub review first.
issuesinwindows/
icon-previews/
img*.png
images.zip
images/
*.gif.local

# Vendored libduckdb prebuilt amalgamation (~32 MB) — fetched at configure time
vendor/duckdb/libduckdb.zip
vendor/duckdb/libduckdb.so
vendor/duckdb/libduckdb_static.a

# Vendored binary deps (downloaded by build scripts)
vendor/

# Test harness scratch — generated artefacts from tests/comprehensive/.
# The harness writes JSON results, captures screenshots, and Python
# byte-caches its runners; none of it is checkable-in source.
tests/comprehensive/results/
tests/comprehensive/screenshots/
tests/comprehensive/__pycache__/
tests/comprehensive/run.log

# Local-only test runners that still bake user-specific paths.
# When their hardcoded `/home/...` paths are scrubbed they can be
# checked in alongside the comprehensive harness.
tests/comprehensive/run_ui_smoke.sh
tests/comprehensive/run_duckdb_tests.py
