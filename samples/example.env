# Notepatra palette preview — synthetic; no real data
# .env file — never commit real credentials.

APP_NAME=notepatra
APP_VERSION=0.1.84
APP_ENV=development
DEBUG=true

# Quoted values
GREETING="Hello, Alice!"
FAREWELL='Goodbye, Bob.'
EMPTY=
SINGLE_WORD=hello

# Spaces and special characters require quoting
WELCOME_MSG="Welcome to Notepatra v0.1.84"
ALLOWED_CHARS="abc def !@#"

# Interpolation
HOST=example.com
PORT=8080
BASE_URL=https://${HOST}:${PORT}/api
FULL_URL=$BASE_URL/v1

# Numeric-looking values are still strings
PI=3.14159
MAX_RETRIES=5
RATE_LIMIT=100

# Multi-line via line continuation
LONG_PATH=/usr/local/bin:\
/usr/bin:\
/bin

# Exported variables (some loaders honor this)
export DATABASE_URL="postgres://example.com/db"
export API_TOKEN="synthetic-placeholder-token"
export REDIS_URL=redis://192.0.2.10:6379/0

# Comments inline are NOT universally supported; keep them on their own line.
LOG_LEVEL=info
LOG_FILE=/var/log/notepatra.log

# Booleans
FEATURE_FLAG_A=true
FEATURE_FLAG_B=false
FEATURE_FLAG_C=1
FEATURE_FLAG_D=0
